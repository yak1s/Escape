{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "jsxImportSource": "preact", "strict": true, "noEmit": true, "skipLibCheck": true,
    "resolveJsonModule": true, "allowJs": false, "types": ["vite/client"]
  },
  "include": ["src", "tests"]
}
